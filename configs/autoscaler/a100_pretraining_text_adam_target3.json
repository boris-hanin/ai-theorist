{
  "model": {
    "vocab_size": 260,
    "context_length": 64,
    "width": 64,
    "depth": 2,
    "num_heads": 4,
    "mlp_multiplier": 4,
    "dropout": 0.0,
    "tie_embeddings": true
  },
  "dataset": {
    "train_path": "data/pretraining/sample_train.txt",
    "validation_path": "data/pretraining/sample_validation.txt",
    "tokenizer": "byte_v1",
    "maximum_bytes": 536870912
  },
  "runtime": {
    "precision": "bf16",
    "attention_backend": "flash",
    "distributed": "none",
    "num_processes": 1
  },
  "scales": [
    {"name": "S1", "width": 64, "depth": 2, "num_heads": 4},
    {"name": "S2", "width": 96, "depth": 3, "num_heads": 6},
    {"name": "S3", "width": 128, "depth": 4, "num_heads": 8}
  ],
  "batch_examples": [4, 8, 16, 32],
  "total_tokens": 131072,
  "checkpoint_tokens": 32768,
  "continuation_tokens": 65536,
  "target_validation_loss": 3.0,
  "validation_interval": 16,
  "validation_examples": 64,
  "gradient_noise_samples": 8,
  "warmup_steps": 16,
  "minimum_learning_rate_ratio": 0.1,
  "seeds": [11, 29],
  "optimizers": [
    {
      "name": "adam",
      "beta1": 0.9,
      "beta2": 0.95,
      "epsilon": 1e-8,
      "weight_decay": 0.0,
      "learning_rates": [0.0001, 0.0003, 0.001]
    }
  ],
  "cache_directory": "runs/autoscaler/a100-pretraining-text-adam-target3/trials"
}

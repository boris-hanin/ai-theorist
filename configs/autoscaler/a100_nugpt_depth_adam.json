{
  "schema_version": 2,
  "name": "a100-nugpt-depth-only-paired",
  "architecture": {
    "block_type": "normalized_transformer",
    "activation": "silu",
    "input_dim": 16,
    "output_dim": 1,
    "residual_multiplier": 1.0,
    "num_experts": 1,
    "active_experts": 1,
    "router_balance_rate": 0.1,
    "vocab_size": 256,
    "context_length": 128,
    "head_dimension": 64,
    "mlp_multiplier": 4,
    "reference_width": 256,
    "reference_depth": 8
  },
  "optimizer": {
    "name": "adam",
    "momentum": 0.0,
    "beta1": 0.9,
    "beta2": 0.95,
    "epsilon": 1e-16
  },
  "dataset": {
    "task_type": "synthetic_markov",
    "n_train": 4096,
    "n_validation": 1024,
    "noise_std": 0.03,
    "seed": 1729
  },
  "horizon": {"steps": 400, "batch_size": 64, "microbatch_size": 16},
  "scales": [
    {"name": "S1", "width": 256, "repeats": 2},
    {"name": "S2", "width": 256, "repeats": 4},
    {"name": "S3", "width": 256, "repeats": 8},
    {"name": "S4", "width": 256, "repeats": 12},
    {"name": "S5", "width": 256, "repeats": 16},
    {"name": "S6", "width": 256, "repeats": 24}
  ],
  "tuning": {
    "normalized_learning_rates": [0.0003, 0.001, 0.003, 0.01, 0.03],
    "max_expansion_rounds": 2,
    "expansion_factor": 3.0
  },
  "validation": {
    "transfer_probe_decades": 0.3,
    "run_negative_control": true,
    "bootstrap_samples": 400,
    "routing_load_tolerance": 0.25
  },
  "seeds": [11, 29, 47, 71],
  "holdout_count": 1
}

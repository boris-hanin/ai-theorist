{
  "architecture": {
    "block_type": "normalized_transformer",
    "activation": "silu",
    "vocab_size": 256,
    "context_length": 128,
    "head_dimension": 64,
    "mlp_multiplier": 4,
    "reference_width": 256,
    "reference_depth": 8
  },
  "dataset": {
    "task_type": "synthetic_markov",
    "n_train": 4096,
    "n_validation": 1024,
    "noise_std": 0.03,
    "seed": 1729,
    "markov_order": 2,
    "markov_states": 16
  },
  "scale": {"name": "fixed-anchor", "width": 128, "repeats": 8},
  "optimizer": {
    "name": "adam",
    "beta1": 0.9,
    "beta2": 0.95,
    "epsilon": 1e-16,
    "weight_decay": 0.0,

{
  "model": {
    "vocab_size": 260,
    "context_length": 128,
    "width": 128,
    "depth": 4,
    "num_heads": 4,
    "mlp_multiplier": 4,
    "dropout": 0.0,
    "tie_embeddings": true
  },
  "dataset": {
    "train_path": "data/pretraining/sample_train.txt",
    "validation_path": "data/pretraining/sample_validation.txt",
    "tokenizer": "byte_v1",
    "maximum_bytes": 68719476736
  },
  "runtime": {
    "precision": "bf16",
    "attention_backend": "flash",
    "distributed": "fsdp",
    "num_processes": 2
  },
  "scales": [
    {"name": "S1", "width": 128, "depth": 4, "num_heads": 4},
    {"name": "S2", "width": 192, "depth": 6, "num_heads": 6},
    {"name": "S3", "width": 256, "depth": 8, "num_heads": 8}
  ],
  "batch_examples": [8, 16, 32, 64],
  "total_tokens": 1048576,
  "checkpoint_tokens": 65536,
  "continuation_tokens": 131072,
  "target_validation_loss": 4.5,
  "validation_interval": 32,
  "validation_examples": 128,
  "gradient_noise_samples": 8,
  "warmup_steps": 16,
  "minimum_learning_rate_ratio": 0.1,
  "seeds": [11, 29],
  "optimizers": [
    {
      "name": "adamw",
      "beta1": 0.9,
      "beta2": 0.95,
      "epsilon": 1e-8,
      "weight_decay": 0.1,
      "learning_rates": [0.0001, 0.0003, 0.001]
    }
  ],
  "cache_directory": "runs/autoscaler/a100-pretraining-text-fsdp/trials"
}

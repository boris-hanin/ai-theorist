{
  "architecture": {
    "block_type": "normalized_transformer",
    "activation": "silu",
    "vocab_size": 16,
    "context_length": 8,
    "head_dimension": 4,
    "mlp_multiplier": 2,
    "reference_width": 16,
    "reference_depth": 2
  },
  "dataset": {
    "task_type": "synthetic_markov",
    "n_train": 128,
    "n_validation": 64,
    "noise_std": 0.03,
    "seed": 1729,
    "markov_order": 2,
    "markov_states": 4
  },
  "scales": [
    {"name": "S1", "width": 8, "repeats": 1},
    {"name": "S2", "width": 12, "repeats": 1},
    {"name": "S3", "width": 16, "repeats": 2}
  ],
  "batch_examples": [1, 2, 4, 8, 16, 32],
  "total_tokens": 2048,
  "checkpoint_tokens": 512,
  "continuation_tokens": 512,
  "target_validation_loss": 2.5,
  "validation_interval": 4,
  "gradient_noise_samples": 12,
  "cache_directory": "runs/autoscaler/batch-census-smoke/trials",
  "seeds": [11, 29],
  "optimizers": [
    {
      "name": "sgd",
      "momentum": 0.0,
      "learning_rates": [0.01, 0.03, 0.1]
    },
    {
      "name": "adam",
      "beta1": 0.9,
      "beta2": 0.99,
      "epsilon": 1e-8,
      "learning_rates": [0.0003, 0.001, 0.003]
    }
  ]
}

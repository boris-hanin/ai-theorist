# Transport artifacts. Bundles are for moving history between machines —
# never a storage location. If content only exists in a bundle, it is not
# in the program record (this cost the program four archive losses).
*.bundle

# Local machine settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/

# Solver outputs — regenerate with scripts/validate.py; commit numbers to
# rounds/<round>/ instead of leaving them loose.
*.npz
scratch/

# Autoscaler runtime output
runs/autoscaler/
apps/web/node_modules/
apps/web/.next/
apps/web/dist/
apps/web/.wrangler/
